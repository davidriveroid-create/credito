#
# Configuracion del sistema de ventas a credito y cobranza.
# Este archivo es EXCLUSIVO de esta aplicacion. No se comparte nada
# con ningun otro programa.
#

# Clave secreta para firmar sesiones y cookies. No compartir.
SECRET_KEY=cambio-esta-clave-por-una-larga-y-aleatoria-9f3a1c7e5b2d8046

# En produccion debe ser False (deja de mostrar paginas de error).
DEBUG=True

# Puerto del servidor. Este sistema usa el 9000.
PUERTO=9000

# Solo permitir abrir el programa desde esta maquina.
# Poner 0.0.0.0 si se quiere que otras personas entren por la red local.
DIRECCION=127.0.0.1

# Carpeta donde queda la base de datos, las fotos de cedula y los respaldos.
CARPETA_DATOS=datos

# Numero de dias de atraso a partir del cual el cliente se marca como MOROSO.
DIAS_MORA=15
